{
  "name": "reino-da-bianca",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reino da Bianca — gamificação de um tabuleiro físico de metas pessoais",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/gen-icons.mjs",
    "prebuild": "node scripts/check-env.mjs && node scripts/validate-art.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "art:validate": "node scripts/validate-art.mjs",
    "art:docs": "vite-node scripts/gen-art-docs.ts",
    "art:guides": "vite-node scripts/gen-art-guides.ts",
    "art:plan": "vite-node scripts/art/cli.ts plan",
    "art:prompt": "vite-node scripts/art/cli.ts prompt",
    "art:process": "vite-node scripts/art/cli.ts process",
    "art:review": "vite-node scripts/art/cli.ts review",
    "art:approve": "vite-node scripts/art/cli.ts approve",
    "art:integrate": "vite-node scripts/art/cli.ts integrate",
    "art:status": "vite-node scripts/art/cli.ts status",
    "art:reopen": "vite-node scripts/art/cli.ts reopen",
    "art:ajuda": "vite-node scripts/art/cli.ts help"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.0.5"
  }
}
