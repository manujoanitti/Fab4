# Copie para .env.local (NÃO versionado). Somente valores PÚBLICOS entram no front-end.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "Publishable" (sb_publishable_…) ou a "anon" legada (JWT). NUNCA use sb_secret_… nem service_role
# (o build recusa chaves privilegiadas: scripts/check-env.mjs).
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Opcional: mostra o botão "Criar conta" na tela de login (deixe desligado se o cadastro público está desativado).
# VITE_ALLOW_SIGNUP=true
# Opcional: base do site (GitHub Pages usa /<nome-do-repo>/). O workflow define automaticamente.
# VITE_BASE=/Fab4/
