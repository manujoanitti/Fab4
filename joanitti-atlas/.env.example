# Joanitti Atlas — variáveis de ambiente do servidor (copie para .env e ajuste; .env é ignorado pelo git)
# Token do administrador (OBRIGATÓRIO em produção; ≥ 16 caracteres). Em desenvolvimento, se ausente, usa "dev-admin-token".
ATLAS_ADMIN_TOKEN=
# Leitura pública (com redação de pessoas vivas). 0 = tudo exige token.
ATLAS_PUBLIC_READ=1
# Caminho do banco SQLite (padrão: data/real/atlas.sqlite) e da pasta de backups (padrão: backups/)
ATLAS_DB=
ATLAS_BACKUP_DIR=
PORT=3001
HOST=127.0.0.1
